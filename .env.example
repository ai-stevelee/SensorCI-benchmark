# =============================================================================
# SensorCI API Keys
# =============================================================================
# Copy this file to .env and fill in your actual keys.
# .env is in .gitignore — your secrets stay local.
#
# Multi-key support: comma-separated, no spaces:
#   OPENAI_API_KEYS=sk-xxx,sk-yyy,sk-zzz
# This enables ~100 concurrent calls when combined across providers.
# =============================================================================

# OpenAI (GPT-5 Pro, GPT-4o, etc.)
OPENAI_API_KEYS=

# Anthropic (Claude Opus 4.7, Claude Sonnet)
ANTHROPIC_API_KEYS=

# Google (Gemini 3 Pro, Gemini 2 Flash)
GOOGLE_API_KEYS=

# Optional: open-model providers (for reviewer condition P8.1, dual-track leaderboard)
TOGETHER_API_KEYS=    # Llama 4 Behemoth, Mistral, Qwen via together.ai
HUGGINGFACE_API_KEYS= # via HF Inference API

# =============================================================================
# Run configuration
# =============================================================================
SENSORCI_DATA_DIR=./data
SENSORCI_RESULTS_DIR=./results
SENSORCI_CACHE_DIR=./.cache

# Per-provider rate limit ceiling (req/min). Set lower if you hit 429.
RPM_OPENAI=10000
RPM_ANTHROPIC=4000
RPM_GOOGLE=2000
RPM_TOGETHER=600

# Hard kill switch for runaway costs (USD)
MAX_API_USD=200
